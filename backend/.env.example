# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Leave empty in development to run a local, persisted mongodb-memory-server
# (data stored in backend/.mongo-data). Set a real URI for staging/production.
MONGO_URI=

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded admin account (created by `npm run seed`)
ADMIN_NAME=Kharna Admin
ADMIN_EMAIL=admin@kharna.in
ADMIN_PASSWORD=Admin@12345

# ── Cloudinary (optional in dev: images fall back to backend/uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (optional in dev: hide online payments, COD still works) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping defaults (overridable from Admin → Settings) ──
SHIPPING_FEE=79
FREE_SHIPPING_THRESHOLD=1999
